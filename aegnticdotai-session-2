    <script>
        // Tailwind
        function initTailwind() {
            // no extra config needed for this prototype
        }

        // Background field canvas (subtle persistent network)
        let fieldCanvas, fieldCtx, nodes = [], mouse = {x: 0, y: 0};

        function initFieldCanvas() {
            fieldCanvas = document.getElementById('hero-field');
            if (!fieldCanvas) return;
            fieldCtx = fieldCanvas.getContext('2d', { alpha: true });

            function resize() {
                fieldCanvas.width = fieldCanvas.offsetWidth * 2;
                fieldCanvas.height = fieldCanvas.offsetHeight * 2;
                fieldCtx.scale(2, 2);
            }
            resize();
            window.addEventListener('resize', resize);

            // create nodes
            for (let i = 0; i < 42; i++) {
                nodes.push({
                    x: Math.random() * fieldCanvas.offsetWidth,
                    y: Math.random() * fieldCanvas.offsetHeight,
                    vx: (Math.random() - 0.5) * 0.3,
                    vy: (Math.random() - 0.5) * 0.3,
                    r: Math.random() * 1.6 + 0.8
                });
            }

            fieldCanvas.addEventListener('mousemove', e => {
                const rect = fieldCanvas.getBoundingClientRect();
                mouse.x = e.clientX - rect.left;
                mouse.y = e.clientY - rect.top;
            });

            animateField();
        }

        function animateField() {
            if (!fieldCtx || !fieldCanvas) return;
            fieldCtx.clearRect(0, 0, fieldCanvas.offsetWidth, fieldCanvas.offsetHeight);

            const w = fieldCanvas.offsetWidth;
            const h = fieldCanvas.offsetHeight;

            for (let i = 0; i < nodes.length; i++) {
                const n = nodes[i];
                n.x += n.vx;
                n.y += n.vy;

                if (n.x < 0 || n.x > w) n.vx *= -1;
                if (n.y < 0 || n.y > h) n.vy *= -1;

                // gentle mouse attraction / repulsion for "coordination" feel
                const dx = mouse.x - n.x;
                const dy = mouse.y - n.y;
                const dist = Math.sqrt(dx*dx + dy*dy) || 1;
                if (dist < 180) {
                    n.vx += (dx / dist) * 0.018;
                    n.vy += (dy / dist) * 0.018;
                }

                // draw
                fieldCtx.fillStyle = 'rgba(0, 212, 184, 0.55)';
                fieldCtx.beginPath();
                fieldCtx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
                fieldCtx.fill();

                // connect to nearby
                for (let j = i + 1; j < nodes.length; j++) {
                    const m = nodes[j];
                    const dx2 = m.x - n.x;
                    const dy2 = m.y - n.y;
                    const d = Math.sqrt(dx2*dx2 + dy2*dy2);
                    if (d < 92) {
                        const alpha = (1 - d / 92) * 0.22;
                        fieldCtx.strokeStyle = `rgba(179, 139, 94, ${alpha})`;
                        fieldCtx.lineWidth = 0.6;
                        fieldCtx.beginPath();
                        fieldCtx.moveTo(n.x, n.y);
                        fieldCtx.lineTo(m.x, m.y);
                        fieldCtx.stroke();
                    }
                }
            }

            requestAnimationFrame(animateField);
        }

        // Skeleton SVG with motion
        let skeletonSvg;

        function initSkeleton() {
            skeletonSvg = document.getElementById('skeleton-svg');
            if (!skeletonSvg) return;

            const W = 860;
            const H = 460;
            skeletonSvg.setAttribute('viewBox', `0 0 ${W} ${H}`);

            const centerX = W / 2;
            const centerY = H / 2 - 10;

            // positions for organs (approximate from the absolute layout)
            const organs = {
                claw: { x: 150, y: 90 },
                auth: { x: 710, y: 90 },
                memory: { x: 170, y: 370 },
                mcp: { x: 690, y: 370 },
                action: { x: 55, y: 230 }
            };

            // draw connections
            Object.keys(organs).forEach(key => {
                const o = organs[key];
                const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                line.setAttribute('x1', centerX);
                line.setAttribute('y1', centerY);
                line.setAttribute('x2', o.x);
                line.setAttribute('y2', o.y);
                line.setAttribute('stroke', '#222228');
                line.setAttribute('stroke-width', '1.5');
                line.setAttribute('stroke-linecap', 'round');
                line.setAttribute('data-organ', key);
                line.setAttribute('class', 'connection');
                skeletonSvg.appendChild(line);

                // animated signal dot (initially hidden)
                const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                dot.setAttribute('r', '2.5');
                dot.setAttribute('fill', '#00d4b8');
                dot.setAttribute('opacity', '0');
                dot.setAttribute('data-signal', key);
                skeletonSvg.appendChild(dot);
            });

            // central node glow already in HTML
        }

        function traceOrgan(card, organKey) {
            const line = skeletonSvg.querySelector(`[data-organ="${organKey}"]`);
            if (!line) return;

            // highlight
            line.setAttribute('stroke', '#00d4b8');
            line.setAttribute('stroke-width', '2.5');

            // animate signal traveling to center
            const signal = skeletonSvg.querySelector(`[data-signal="${organKey}"]`);
            if (signal) {
                const x1 = parseFloat(line.getAttribute('x1'));
                const y1 = parseFloat(line.getAttribute('y1'));
                const x2 = parseFloat(line.getAttribute('x2'));
                const y2 = parseFloat(line.getAttribute('y2'));

                signal.setAttribute('cx', x2);
                signal.setAttribute('cy', y2);
                signal.setAttribute('opacity', '1');

                let progress = 0;
                const anim = setInterval(() => {
                    progress += 0.045;
                    if (progress >= 1) {
                        clearInterval(anim);
                        signal.setAttribute('opacity', '0');
                        line.setAttribute('stroke', '#222228');
                        line.setAttribute('stroke-width', '1.5');
                        return;
                    }
                    const cx = x2 + (x1 - x2) * progress;
                    const cy = y2 + (y1 - y2) * progress;
                    signal.setAttribute('cx', cx);
                    signal.setAttribute('cy', cy);
                }, 16);
            }

            // brief card emphasis
            card.style.transitionDuration = '80ms';
            card.style.borderColor = 'rgba(0, 212, 184, 0.45)';
            setTimeout(() => {
                if (card) card.style.borderColor = 'rgba(255,255,255,0.1)';
            }, 900);
        }

        // Continuity demo (small living orchestration + memory visual)
        let continuityCanvas, cCtx, cNodes = [], cMemory = [];

        function initContinuityDemo() {
            continuityCanvas = document.getElementById('continuity-canvas');
            if (!continuityCanvas) return;
            cCtx = continuityCanvas.getContext('2d');

            function resize() {
                continuityCanvas.width = continuityCanvas.offsetWidth * 2;
                continuityCanvas.height = continuityCanvas.offsetHeight * 2;
                cCtx.scale(2, 2);
            }
            resize();
            window.addEventListener('resize', resize);

            // create coordinated nodes
            for (let i = 0; i < 7; i++) {
                cNodes.push({
                    x: 60 + (i % 4) * 78,
                    y: 48 + Math.floor(i / 4) * 92,
                    baseX: 60 + (i % 4) * 78,
                    baseY: 48 + Math.floor(i / 4) * 92,
                    phase: i * 0.9,
                    size: 5.5
                });
            }

            // mouse drag support
            let dragging = null;
            continuityCanvas.addEventListener('mousedown', e => {
                const rect = continuityCanvas.getBoundingClientRect();
                const mx = (e.clientX - rect.left) * 2;
                const my = (e.clientY - rect.top) * 2;
                dragging = cNodes.find(n => Math.hypot(n.x - mx, n.y - my) < 18);
            });

            window.addEventListener('mouseup', () => dragging = null);
            continuityCanvas.addEventListener('mousemove', e => {
                if (!dragging) return;
                const rect = continuityCanvas.getBoundingClientRect();
                dragging.x = (e.clientX - rect.left) * 2;
                dragging.y = (e.clientY - rect.top) * 2;
            });

            animateContinuity();
            
            // persist a little "memory" state
            setInterval(() => {
                cMemory.push(Date.now());
                if (cMemory.length > 9) cMemory.shift();
                const stateEl = document.getElementById('continuity-state');
                if (stateEl) stateEl.textContent = `PERSISTING • ${cMemory.length} EVENTS`;
            }, 1650);
        }

        function animateContinuity() {
            if (!cCtx || !continuityCanvas) return;
            const w = continuityCanvas.offsetWidth;
            const h = continuityCanvas.offsetHeight;
            cCtx.clearRect(0, 0, w * 2, h * 2);

            const time = Date.now() / 900;

            // draw connections (orchestration)
            cCtx.strokeStyle = 'rgba(179, 139, 94, 0.35)';
            cCtx.lineWidth = 1.2;
            for (let i = 0; i < cNodes.length; i++) {
                for (let j = i + 1; j < cNodes.length; j++) {
                    const a = cNodes[i], b = cNodes[j];
                    const dist = Math.hypot(a.x - b.x, a.y - b.y);
                    if (dist < 165) {
                        cCtx.beginPath();
                        cCtx.moveTo(a.x, a.y);
                        cCtx.lineTo(b.x, b.y);
                        cCtx.stroke();
                    }
                }
            }

            // draw nodes with phase (continuity + memory)
            cNodes.forEach((n, i) => {
                const pulse = Math.sin(time + n.phase) * 0.8 + 1.1;
                const x = n.x;
                const y = n.y;

                // memory trail (fading dots)
                cCtx.fillStyle = 'rgba(0, 212, 184, 0.15)';
                for (let k = 0; k < 3; k++) {
                    const tx = n.baseX + (x - n.baseX) * (0.3 * k);
                    const ty = n.baseY + (y - n.baseY) * (0.3 * k);
                    cCtx.beginPath();
                    cCtx.arc(tx, ty, (n.size * pulse) * (0.6 - k * 0.18), 0, Math.PI * 2);
                    cCtx.fill();
                }

                // main node
                cCtx.fillStyle = i % 2 === 0 ? '#00d4b8' : '#b38b5e';
                cCtx.beginPath();
                cCtx.arc(x, y, n.size * pulse * 0.9, 0, Math.PI * 2);
                cCtx.fill();

                // subtle ring for supervision/sovereignty
                cCtx.strokeStyle = 'rgba(255,255,255,0.15)';
                cCtx.lineWidth = 1;
                cCtx.beginPath();
                cCtx.arc(x, y, n.size * pulse * 1.45, 0, Math.PI * 2);
                cCtx.stroke();
            });

            requestAnimationFrame(animateContinuity);
        }

        // Make skeleton organs interactive with the SVG
        function enhanceSkeletonInteractivity() {
            document.querySelectorAll('.organ').forEach(card => {
                card.addEventListener('mouseenter', () => {
                    const key = card.dataset.organ;
                    const line = document.querySelector(`[data-organ="${key}"]`);
                    if (line) {
                        line.setAttribute('stroke', '#00d4b8');
                        line.setAttribute('stroke-width', '2.8');
                    }
                });
                card.addEventListener('mouseleave', () => {
                    const key = card.dataset.organ;
